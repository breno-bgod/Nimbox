{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Nimbox Design System",
  "version": "1.0.0",
  "status": "proposed-for-review",
  "reference": "Nimbox Preview Premium 3.0 / Preview 3.1 Limpo",
  "scope": "design-only; no runtime behavior changes",
  "color": {
    "surface": {
      "void": "#040B16",
      "base": "#061A2B",
      "header": "#051B2C",
      "panel": "#09283D",
      "raised": "#123B55"
    },
    "text": {
      "primary": "#EFF9FF",
      "secondary": "#BDCEDA",
      "tertiary": "#8EACBE"
    },
    "accent": {
      "primary": "#79DFFF",
      "bright": "#97F5FF",
      "secondary": "#51CBDF"
    },
    "border": {
      "default": "#5E9CB5"
    },
    "status": {
      "success": "#71E6A3",
      "warning": "#FFC978",
      "danger": "#FF7C8D"
    }
  },
  "environmentThemes": {
    "aurora": {
      "sky": "#8CBED5",
      "horizon": "#A7D5E8",
      "mid": "#4F82A7",
      "low": "#1C4764",
      "glow": "#70D8FF",
      "accent": "#82E5FF"
    },
    "infinityLight": {
      "sky": "#DEEEF1",
      "horizon": "#D7EDEF",
      "mid": "#A0C6CE",
      "low": "#45738D",
      "glow": "#E7FAFF",
      "accent": "#8DE8E5"
    },
    "nimboxBlue": {
      "sky": "#80B6D7",
      "horizon": "#79BEDA",
      "mid": "#367BA6",
      "low": "#163F6A",
      "glow": "#56C0FF",
      "accent": "#6DD3FF"
    },
    "emerald": {
      "sky": "#8ECFC2",
      "horizon": "#B4E3D8",
      "mid": "#4A978F",
      "low": "#22565D",
      "glow": "#77F3D3",
      "accent": "#83F0C6"
    },
    "cinemaDark": {
      "sky": "#4E7085",
      "horizon": "#557C8E",
      "mid": "#23475E",
      "low": "#081D32",
      "glow": "#6ECBE4",
      "accent": "#76D8EE"
    }
  },
  "typography": {
    "family": [
      "Inter",
      "system-ui",
      "sans-serif"
    ],
    "levelsPx1600x900": {
      "display": 44,
      "heading1": 34,
      "heading2": 24,
      "heading3": 19,
      "body": 16,
      "meta": 14,
      "caption": 12
    },
    "weight": {
      "regular": 450,
      "medium": 500,
      "semibold": 650,
      "bold": 750,
      "black": 800
    }
  },
  "layout": {
    "reference": {
      "width": 1600,
      "height": 900
    },
    "spacingPx": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64
    ],
    "horizontalMarginPx": 68,
    "cornerRadiusPx": {
      "small": 8,
      "card": 12,
      "panel": 18,
      "pill": 999
    }
  },
  "lighting": {
    "reflectionDefault": 0.44,
    "reflectionBlurPx": 2,
    "casePerspectivePx": 1250,
    "focusHalo": "soft cyan",
    "floorHorizon": "continuous gradient, no hard line"
  },
  "motion": {
    "focusMs": 120,
    "pressMs": 95,
    "pageMs": 300,
    "modalMs": 220,
    "carouselMs": 920,
    "feedbackMs": 180,
    "discRevolutionMs": 7500,
    "carouselEasing": [
      0.21,
      0.76,
      0.16,
      1
    ],
    "reducedMotion": "remove nonessential rotation/parallax; instant or short fade"
  },
  "sound": {
    "status": "design proposal; no SFX shipped",
    "events": {
      "focusMs": [
        35,
        70
      ],
      "selectMs": [
        90,
        160
      ],
      "backMs": [
        65,
        125
      ],
      "openMs": [
        130,
        210
      ],
      "errorMs": [
        140,
        230
      ],
      "readyMs": [
        140,
        220
      ]
    },
    "rules": [
      "not continuous",
      "independent UI gain",
      "respect mute and system accessibility",
      "never copy other console SFX"
    ]
  },
  "interaction": {
    "minFocusContrastRatio": 3,
    "targetNormalTextContrastRatio": 4.5,
    "focusVisible": true,
    "backRestoresContext": true,
    "noFakeActions": true,
    "controllerFirst": true
  },
  "components": [
    "AppShell",
    "TopNav",
    "FocusRing",
    "GameCase3D",
    "CaseCarousel",
    "GameRail",
    "GameDetails",
    "Button",
    "Chip",
    "Panel",
    "SettingRow",
    "Progress",
    "InputHint",
    "Toast"
  ],
  "screens": [
    "Login",
    "Home",
    "Library",
    "GameDetails",
    "Settings",
    "Streaming"
  ],
  "changePolicy": "design documentation/tokens only; approval and visual parity test required before C++ integration"
}
